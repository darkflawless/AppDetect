<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card_bordered">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="22sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Báo cáo sự cố trên đường"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_title" />
    </LinearLayout>

    <!-- Loại sự cố -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loại sự cố (*)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/sp_incident_type"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_bordered"
        android:layout_marginBottom="14dp"
        android:paddingHorizontal="10dp" />

    <!-- Mức độ nghiêm trọng -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mức độ nghiêm trọng (*)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/sp_incident_severity"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_bordered"
        android:layout_marginBottom="14dp"
        android:paddingHorizontal="10dp" />

    <!-- Mô tả chi tiết -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mô tả sự cố"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_incident_description"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="top|start"
        android:hint="Ví dụ: Xe nổ lốp trước bên phải, cần hỗ trợ cứu hộ thay lốp gấp..."
        android:textSize="13sp"
        android:textColor="@color/text_main"
        android:background="@drawable/bg_card_bordered"
        android:padding="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Vị trí GPS tự động -->
    <TextView
        android:id="@+id/tv_incident_location_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Vị trí: Đang xác định tọa độ GPS..."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <!-- Nút hành động -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_incident_cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Hủy"
            android:textColor="@color/text_secondary"
            android:background="?attr/selectableItemBackground"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_incident_submit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Gửi báo cáo"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_incident"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

</LinearLayout>

