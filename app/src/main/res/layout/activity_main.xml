<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera preview toàn màn hình -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay vẽ bounding box -->
    <com.example.myapplication.ui.BoundingBoxOverlay
        android:id="@+id/bbox_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Red flash overlay cảnh báo ngủ gật -->
    <View
        android:id="@+id/red_flash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FF0000"
        android:visibility="gone" />

    <!-- Thanh trạng thái phía trên -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:background="#88000000"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 Phát hiện dây an toàn"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fps_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="-- FPS"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Switch Camera"
            android:scaleType="centerInside"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Panel kết quả phía dưới -->
    <LinearLayout
        android:id="@+id/status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="40dp"
        android:paddingHorizontal="24dp"
        android:background="#CC000000">

        <!-- Icon trạng thái lớn -->
        <TextView
            android:id="@+id/status_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷"
            android:textSize="48sp" />

        <!-- Text trạng thái chính -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hướng camera vào người lái"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Confidence score -->
        <TextView
            android:id="@+id/confidence_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#BBFFFFFF"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Lớp phủ nút Bắt đầu hành trình -->
    <LinearLayout
        android:id="@+id/start_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xác thực thành công!"
            android:textColor="#4CAF50"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_start_trip"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:text="BẮT ĐẦU HÀNH TRÌNH"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhấn để bắt đầu giám sát an toàn"
            android:textColor="#AAAAAA"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

</FrameLayout>